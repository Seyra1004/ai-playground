[Unit]
Description=SWIPE_INFO daily pipeline (research -> verify -> semantic -> render -> QA -> review page -> Kakao), no auto-publish
Wants=network-online.target
After=network-online.target
OnFailure=social-automation-swipe-info-failure@%n.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/opt/ai-playground-src-v2/social-automation
Environment=SOCIAL_AUTOMATION_NO_PAYG=1
ExecStartPre=/usr/bin/git -C /opt/ai-playground-src-v2 fetch origin main
ExecStartPre=/usr/bin/git -C /opt/ai-playground-src-v2 reset --hard origin/main
ExecStart=/opt/ai-playground-src-v2/social-automation/.venv/bin/python3 /opt/ai-playground-src-v2/social-automation/scripts/run_daily_full.py --account swipe_info
TimeoutStartSec=20min
StandardOutput=journal
StandardError=journal
