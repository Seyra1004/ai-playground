[Unit]
Description=SWIPE_INFO daily content pipeline (discovery -> scoring -> verification -> render -> QA, no auto-publish)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/opt/ai-playground-src-v2/social-automation
Environment=SOCIAL_AUTOMATION_NO_PAYG=1
ExecStart=/opt/ai-playground-src-v2/social-automation/.venv/bin/python3 /opt/ai-playground-src-v2/social-automation/scripts/run_daily.py --account swipe_info
TimeoutStartSec=15min
StandardOutput=journal
StandardError=journal
