# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# Kakao Developers Console app credentials (long-lived; not rotated automatically)
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# Must exactly match the Redirect URI registered in the Kakao Developers Console
KAKAO_REDIRECT_URI=http://localhost:3000/oauth

KAKAO_DEFAULT_LINK_URL=

# Naver Developers application credentials, used by the naver_news_api
# ingestion adapter (see sources.yaml -> naver_news -> auth.credential_env).
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Report V1 (news synthesis). LLM_PROVIDER/LLM_MODEL are config-driven --
# changing the model is a value edit here, never a code change (see
# report/llm_interface.py). Only 'anthropic' is supported as LLM_PROVIDER
# in V1. LLM_MODEL defaults to 'claude-opus-5' if unset.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5
ANTHROPIC_API_KEY=
