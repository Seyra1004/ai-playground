# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# Kakao Developers Console app credentials (long-lived; not rotated automatically)
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# Must exactly match the Redirect URI registered in the Kakao Developers Console
KAKAO_REDIRECT_URI=http://localhost:3000/oauth

KAKAO_DEFAULT_LINK_URL=

# Naver Developers application credentials, used by the naver_news_api
# ingestion adapter (see sources.yaml -> naver_news -> auth.credential_env).
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
