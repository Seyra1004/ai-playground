# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# Kakao Developers Console app credentials (long-lived; not rotated automatically)
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# Must exactly match the Redirect URI registered in the Kakao Developers Console
KAKAO_REDIRECT_URI=http://localhost:3000/oauth

KAKAO_DEFAULT_LINK_URL=

# Optional. report_delivery_v2.py's CTA link defaults to
# KAKAO_DEFAULT_LINK_URL + "/v2/" (the real V2.1 dashboard path under the
# same registered domain) when this is unset -- only set it to override
# that derivation.
KAKAO_V2_LINK_URL=

# Naver Developers application credentials, used by the naver_news_api
# ingestion adapter (see sources.yaml -> naver_news -> auth.credential_env).
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Report V1 (news synthesis). LLM_PROVIDER/LLM_MODEL are config-driven --
# changing the model is a value edit here, never a code change (see
# report/llm_interface.py). Only 'anthropic' is supported as LLM_PROVIDER
# in V1. LLM_MODEL defaults to 'claude-opus-5' if unset.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5
ANTHROPIC_API_KEY=

# Report V2 (Korean translation). Independent of LLM_PROVIDER/LLM_MODEL
# above -- can point at a different provider/model later with zero core
# pipeline changes (see report/translation.py). Only 'none'/'anthropic'
# are supported as TRANSLATION_PROVIDER. Reuses ANTHROPIC_API_KEY above
# when TRANSLATION_PROVIDER=anthropic. ANTHROPIC_TRANSLATION_MODEL
# defaults to 'claude-haiku-4-5-20251001' if unset.
TRANSLATION_PROVIDER=none
ANTHROPIC_TRANSLATION_MODEL=claude-haiku-4-5-20251001

# Phase 3D-BACKUP: offsite database backup to Cloudflare R2 (see
# db/r2_client.py). A dedicated R2 API token scoped to the SUPER NEWS
# backup bucket only is recommended over a full-account token. Set these
# via the Cloudflare dashboard/CLI directly -- never paste the real
# values into a chat session. Leaving these unset means db/r2_client.py.
# is_configured() is False and scripts/backup_database.py stops at
# R2_CONFIGURATION_REQUIRED (local snapshot+verification still runs).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Defaults to 'super-news-backups' if unset.
R2_BUCKET_NAME=super-news-backups
# Reference free-tier storage allowance in GB, used only for capacity
# alert thresholds (db/backup.py's classify_capacity) -- update if
# Cloudflare's actual published R2 Standard Storage free allowance
# changes. Defaults to 10 if unset.
R2_FREE_STORAGE_GB=10
